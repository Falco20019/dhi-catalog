From 303cbeb50f4dd4332d416f04b85adb3c9aa61c4b Mon Sep 17 00:00:00 2001
From: Christian Dupuis <cd@docker.com>
Date: Thu, 30 Oct 2025 09:42:12 +0100
Subject: [PATCH] Disable deprecation warnings

Upstream source: https://github.com/gradle/gradle/blob/v9.8.1/build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts
Base tree:
 Package: gradle 9.8.1
 Orig: https://github.com/gradle/gradle/archive/refs/tags/v9.8.1.tar.gz
 SHA256: d8baf550bbd247390c7a02002cf8a9ce371ae60981981f3d6197e4f0a436f076
 Layout: gradle-9.8.1
Files: build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts
Adaptation: DHI build-only patch that removes -Werror and disables deprecation
 warnings so upstream Gradle can be rebuilt with the current toolchain.

---
 .../jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts b/build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts
index f0333160f4e..2ab908295d8 100644
--- a/build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts
+++ b/build-logic/jvm/src/main/kotlin/gradlebuild.strict-compile.gradle.kts
@@ -18,7 +18,7 @@ import gradlebuild.jvm.extension.StrictCompileExtension
 
 extensions.create<StrictCompileExtension>("strictCompile")
 
-val strictCompilerArgs = listOf("-Werror", "-Xlint:all", "-Xlint:-options", "-Xlint:-serial", "-Xlint:-classfile", "-Xlint:-try")
+val strictCompilerArgs = listOf("-Xlint:all", "-Xlint:-options", "-Xlint:-serial", "-Xlint:-classfile", "-Xlint:-try", "-Xlint:-deprecation")
 
 tasks.withType<JavaCompile>().configureEach {
     // Generated classes may not adhere to the strict no-warning policy that we apply to handwritten code
-- 
