Stage the gather archive in a temp directory instead of /must-gather-archive.
Upstream 2.12.9 moved tarball creation into common.sh tar_artifacts(); the
hardcoded /must-gather-archive path still fails for nonroot users because
unlinking from / needs write access on /. Upstreamable fix:
https://github.com/kubev2v/forklift-must-gather/blob/e9e3bdd915c3fbac24ea9f5e8a1e8a02d97613b1/collection-scripts/common.sh

diff --git a/collection-scripts/common.sh b/collection-scripts/common.sh
--- a/collection-scripts/common.sh
+++ b/collection-scripts/common.sh
@@ -40,7 +40,7 @@ tar_artifacts() {
     esac
 
     echo "Tarring must-gather artifacts..."
-    local archive_path="/must-gather-archive"
+    local archive_path="$(mktemp -d)"
     mkdir -p "${archive_path}" || return 1
 
     # Create the archive first; only remove the originals once it exists so a
