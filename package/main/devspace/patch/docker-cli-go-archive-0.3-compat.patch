# Subject: Adapt Docker CLI 28 for go-archive 0.3 compression constants
#
# CVE-2026-17106 affects go-archive extraction helpers. The fix shipped in
# go-archive 0.3.0 moved compression constants such as Gzip from the root
# archive package into github.com/moby/go-archive/compression:
# https://github.com/moby/go-archive/pull/45
# https://github.com/moby/go-archive/releases/tag/v0.3.0
#
# DevSpace 6.3.21 pins Docker CLI 28.2.2, which still references archive.Gzip
# in cli/command/image/build/context.go. Docker 29 removed pkg/archive entirely
# rather than updating this call site:
# https://github.com/moby/moby/commit/66e9cd97f29ac2758dfd3814040033bb879d706d
#
# DHI modifications:
# - Change archive.Gzip to compression.Gzip in the one remaining call site.
# - Preserve Docker CLI 28 behavior while allowing go-archive 0.3 to compile.
diff --git a/vendor/github.com/docker/cli/cli/command/image/build/context.go b/vendor/github.com/docker/cli/cli/command/image/build/context.go
--- a/vendor/github.com/docker/cli/cli/command/image/build/context.go
+++ b/vendor/github.com/docker/cli/cli/command/image/build/context.go
@@ -427,7 +427,7 @@ func Compress(buildCtx io.ReadCloser) (io.ReadCloser, error) {
 	pipeReader, pipeWriter := io.Pipe()
 
 	go func() {
-		compressWriter, err := compression.CompressStream(pipeWriter, archive.Gzip)
+		compressWriter, err := compression.CompressStream(pipeWriter, compression.Gzip)
 		if err != nil {
 			pipeWriter.CloseWithError(err)
 		}
