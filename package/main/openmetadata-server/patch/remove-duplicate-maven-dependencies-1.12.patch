Subject: Remove duplicate Maven dependency declarations for Maven 3.10
Origin: DHI-internal build compatibility fix for the OpenMetadata 1.12.14 release
Upstream source: https://github.com/open-metadata/OpenMetadata/tree/1.12.14-release
Description: Maven 3.10 rejects duplicate dependency keys. Keep the testcontainers
 declaration that excludes commons-compress and the compile-scoped
 dropwizard-jersey declaration; remove only their redundant counterparts.

diff --git a/openmetadata-service/pom.xml b/openmetadata-service/pom.xml
--- a/openmetadata-service/pom.xml
+++ b/openmetadata-service/pom.xml
@@ -566,12 +566,6 @@
       <version>8.6.0</version>
       <scope>test</scope>
     </dependency>
-    <dependency>
-      <groupId>org.testcontainers</groupId>
-      <artifactId>testcontainers</artifactId>
-      <version>${org.testcontainers.version}</version>
-      <scope>test</scope>
-    </dependency>
     <dependency>
       <groupId>org.testcontainers</groupId>
       <artifactId>minio</artifactId>
diff --git a/openmetadata-mcp/pom.xml b/openmetadata-mcp/pom.xml
--- a/openmetadata-mcp/pom.xml
+++ b/openmetadata-mcp/pom.xml
@@ -157,12 +157,6 @@
             <artifactId>jetty-io</artifactId>
             <version>${jetty.version}</version>
         </dependency>
-        <dependency>
-            <groupId>io.dropwizard</groupId>
-            <artifactId>dropwizard-jersey</artifactId>
-            <version>${dropwizard.version}</version>
-            <scope>test</scope>
-        </dependency>
         <dependency>
             <groupId>org.assertj</groupId>
             <artifactId>assertj-core</artifactId>
