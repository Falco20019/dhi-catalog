Subject: Remove duplicate Maven dependency declaration for Maven 3.10
Origin: DHI-internal build compatibility fix for the OpenMetadata 2.0.4 release
Upstream source: https://github.com/open-metadata/OpenMetadata/tree/2.0.4-release
Description: Maven 3.10 rejects duplicate dependency keys. Keep the first
 dropwizard-http2 declaration and remove the identical later declaration and
 its duplicate explanatory comment.

diff --git a/openmetadata-service/pom.xml b/openmetadata-service/pom.xml
--- a/openmetadata-service/pom.xml
+++ b/openmetadata-service/pom.xml
@@ -201,18 +201,6 @@
       <groupId>io.dropwizard</groupId>
       <artifactId>dropwizard-jdbi3</artifactId>
     </dependency>
-    <!--
-      dropwizard-http2 registers `type: h2` (TLS) and `type: h2c` (cleartext) connector
-      factories via META-INF/services. Adding the dep is what makes those connector types
-      available in conf/openmetadata.yaml — without it, "type: h2c" fails at startup with
-      "unknown connector type". Both factories are backward-compatible with HTTP/1.1 clients
-      on the same port (cleartext via Upgrade, TLS via ALPN), so adopting them does not
-      break existing clients.
-    -->
-    <dependency>
-      <groupId>io.dropwizard</groupId>
-      <artifactId>dropwizard-http2</artifactId>
-    </dependency>
     <dependency>
       <groupId>org.jdbi</groupId>
       <artifactId>jdbi3-sqlobject</artifactId>
