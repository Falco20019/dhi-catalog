Description: Guard the root-flow conf chown on file existence. The upstream
 root flow chowns ETCD_CONF_FILE unconditionally, but the file only exists
 when ETCD_CFG_* variables created it, so a root-run container without
 configuration variables exits 1 before starting etcd. Guard the chown on
 file existence; the non-root flow is unaffected. Upstream shares the defect
 but never hits it (their image defaults to uid 1001); the DHI dev variants
 default to root, which makes this path live. Patched file:
 https://github.com/milvus-io/bitnami-docker-etcd/blob/3.5.30-r1/3.5/ubuntu22.04/rootfs/opt/bitnami/scripts/libetcd.sh
Origin: vendor, DHI packaging fix
Forwarded: no
--- a/3.5/ubuntu22.04/rootfs/opt/bitnami/scripts/libetcd.sh
+++ b/3.5/ubuntu22.04/rootfs/opt/bitnami/scripts/libetcd.sh
@@ -98,7 +98,7 @@
             fi
         fi
     done
-    if am_i_root; then
+    if am_i_root && [[ -f "$ETCD_CONF_FILE" ]]; then
         chown "$ETCD_DAEMON_USER" "$ETCD_CONF_FILE"
     fi
 }
